        <script><![CDATA[(function executeRule(current, previous /*null when insert*/) {

    var restMsg = new sn_ws.RESTMessageV2('Notify on Attendee Registration', 'POST');

    restMsg.setStringParameterNoEscape('name', current.getValue('x_name'));
    restMsg.setStringParameterNoEscape('email', current.getValue('x_email'));
    restMsg.setStringParameterNoEscape('event', current.getDisplayValue('x_event'));

    try {
        var response = restMsg.execute();
        var httpStatus = response.getStatusCode();
        var responseBody = response.getBody();

        gs.info('Attendee registration sent. Status: ' + httpStatus + ', Response: ' + responseBody);
    } catch (ex) {
        gs.error('Failed to send attendee registration: ' + ex.message);
    }

})(current, previous);
]]></script>
