        <name>Submit Feedback</name>
        <onclick>submitFeedback()</onclick>
        <order>100</order>
        <script><![CDATA[function submitFeedback() {
	var rating = prompt("Rate your experience (1 to 5):");
	if (!rating) return alert("Cancelled.");

	var ratingNum = parseInt(rating);
	if (isNaN(ratingNum) || ratingNum < 1 || ratingNum > 5) {
		alert("Invalid rating. Please enter a number from 1 to 5.");
		return;
	}

	var comments = prompt("Enter your feedback comments:");
	
	var ga = new GlideAjax('x_1790139_event_ma.FeedbackUtils');
	ga.addParam('sysparm_name', 'submit');
	ga.addParam('sysparm_rating', rating);
	ga.addParam('sysparm_comments', comments);
	ga.addParam('sysparm_event_id', g_form.getUniqueValue());
	ga.addParam('sysparm_user_id', g_user.userID);
	
	ga.getXMLAnswer(function(response) {
		g_form.addInfoMessage("Thank you for your feedback!");
		g_form.reload();
	});
}
]]></script>
