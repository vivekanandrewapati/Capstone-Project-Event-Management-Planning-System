        <script><![CDATA[(function executeRule(current, previous /*null when insert*/) {
    var restMsg = new sn_ws.RESTMessageV2('Notify External on Feedback Received', 'POST');

    restMsg.setStringParameterNoEscape('user', current.getDisplayValue('x_user'));
    restMsg.setStringParameterNoEscape('feedback', current.getValue('x_feedback'));
    restMsg.setStringParameterNoEscape('rating', current.getValue('x_rating'));
    restMsg.setStringParameterNoEscape('sys_created_on', current.getValue('sys_created_on'));

    try {
        var response = restMsg.execute();
        var status = response.getStatusCode();
        var body = response.getBody();
        gs.info('Feedback notification sent. Status: ' + status + ', Response: ' + body);
    } catch (ex) {
        gs.error('Failed to send feedback notification: ' + ex.message);
    }
})(current, previous);
]]></script>
