        <name>Register Attendee</name>
        <onclick>registerAttendee()</onclick>
        <order>100</order>
        <script><![CDATA[function registerAttendee() {
	var firstName = prompt("Enter First Name:");
	if (!firstName) return alert("Cancelled.");

	var lastName = prompt("Enter Last Name:");
	if (!lastName) return alert("Cancelled.");

	var email = prompt("Enter Email:");
	if (!email) return alert("Cancelled.");

	var contact = prompt("Enter Contact Number:");
	if (!contact) return alert("Cancelled.");


	var ga = new GlideAjax('x_1790139_event_ma.RegisterAttendeeUtils');
	ga.addParam('sysparm_name', 'register');
	ga.addParam('sysparm_first_name', firstName);
	ga.addParam('sysparm_last_name', lastName);
	ga.addParam('sysparm_email', email);
	ga.addParam('sysparm_contact', contact);
	ga.addParam('sysparm_event_id', g_form.getUniqueValue());
	ga.getXMLAnswer(function(response) {
		g_form.addInfoMessage("Attendee registered successfully.");
		g_form.reload();
	});
}
]]></script>
