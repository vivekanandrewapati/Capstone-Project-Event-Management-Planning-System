        <name>Validate end_time after start_time</name>
        <order/>
        <script><![CDATA[function onSubmit() {
  var startTime = g_form.getValue('x_start_time');
  var endTime = g_form.getValue('x_end_time');

 

 
  var startDate = new Date(startTime);
  var endDate = new Date(endTime);

  if (endDate < startDate) {
    g_form.addErrorMessage('End Time cannot be before Start Time.');
    g_form.setFocus('end_time');
    return false; 
  }

  return true; 
}
]]></script>
