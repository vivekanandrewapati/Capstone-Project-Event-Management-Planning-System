        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading || newValue == '') {
      return;
   }

	var loc = g_form.getValue('x_location');
	var eventUtils = new GlideAjax('x_1790139_event_ma.EventUtilsClient');
	eventUtils.addParam('sysparm_name', 'checkLocation');
	eventUtils.addParam('sysparm_location_id', loc);
	eventUtils.getXMLAnswer(getResponse);

	function getResponse(result){
		var _res = result;
		if(_res == 'false'){
			g_form.addErrorMessage('Location not available');
		}
	}
}]]></script>
